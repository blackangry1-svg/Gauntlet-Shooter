config_version=5

[application]
config/name="Gauntlet Souls-FPS"
run/main_scene="res://scenes/adventure.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60

[autoload]
Global="*res://scripts/global.gd"
Adventure="*res://scripts/adventure_state.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
scaling_3d/scale=0.75
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)